          "_name": "footer2",
          "_sourceTheme": "wellnessm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer2\" group=\"Footers\" global once=\"footers\" mbr-class=\"{'mbr-reveal': reveal, 'mbr-parallax-background': bg.parallax}\">\n    \n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"3\" max=\"8\" step=\"0.1\" value=\"8\" condition=\"showLogo\">\n        <input type=\"checkbox\" title=\"Brand\" name=\"showBrand\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopyright\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/wellnessm5/components/_images/background1.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#232323\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#121212\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-md-3 soc\">\n                <ul class=\"list mbr-fonts-style cont\" mbr-theme-style=\"display-4\" data-app-selector=\".cont\" data-multiline mbr-article><p><b>LINKS</b></p><p><b>coming soon</b></p></ul>\n            </div>\n            <div class=\"col-12 col-md col-lg\">\n                <h5 mbr-text class=\"mbr-section-subtitle mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\"><b>\n                    PHONE</b></h5>\n                <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list\" data-multiline mbr-article>\n                    <li class=\"mbr-text item-wrap\"><b><a href=\"tel:251-331-2747\" class=\"text-white\">251-331-2747</a></b></li>\n                </ul>\n            </div>\n            <div class=\"col-12 col-md col-lg\">\n                <h5 mbr-text class=\"mbr-section-subtitle mbr-fonts-style mb-3\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\"><b>\n                    LOCATION</b></h5>\n                <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list\" data-multiline mbr-article>\n                    <li class=\"mbr-text item-wrap\"><b><a href=\"https://share.google/ZGANuPJrES9EW3oVA\" class=\"text-white\" target=\"_blank\">3758 Dauphin Island Pkwy\n</a></b></li><li class=\"mbr-text item-wrap\"><b><a href=\"https://share.google/ZGANuPJrES9EW3oVA\" class=\"text-white\" target=\"_blank\">Mobile, AL 36605</a></b></li>\n                </ul>\n            </div>\n            <div class=\"col-12 col-lg-3 logo\" mbr-if=\"showLogo || showBrand\">\n                <div class=\"si\" mbr-if=\"showLogo\">\n                    <img class=\"sign\" src=\"@PROJECT_PATH@/assets/images/cow-logo-with-horns-.png-1024x1024.png\" alt=\"Bama Bob's BBQ\" mbr-style=\"{'height': logoSize + 'rem'}\">\n                </div>\n                <p class=\"mbr-text text mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".text, .si\" mbr-if=\"showBrand\"><b>\n                    Bama Bob's</b></p>\n            </div>\n            <div class=\"col-12\">\n                <p class=\"mb-0 copyright mbr-fonts-style mbr-white align-center mt-4\" mbr-theme-style=\"display-4\" data-app-selector=\".copyright\" mbr-if=\"showCopyright\">\n                    © Copyright 2025 Bama Bob's. All Rights Reserved.\n                </p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".row": {
              "flex-direction": "row-reverse"
            },
            "img": {
              "display": "inline"
            },
            ".si": {
              "width": "100%"
            },
            ".si img": {
              "width": "auto"
            },
            ".text": {
              "color": "#ffffff"
            },
            ".text, .si": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".copyright": {
              "color": "#000000"
            },
            ".list": {
              "letter-spacing": ".2em",
              "list-style": "none",
              "padding-left": "0",
              "@media (max-width: 991px)": {
                "margin-bottom": "2rem"
              },
              "@media (min-width: 992px)": {
                "margin-bottom": "0rem"
              },
              "color": "#000000",
              "li": {
                "margin-bottom": ".5rem"
              }
            },
            ".mbr-section-title": {
              "color": "#ffffff"
            },
            "@media (max-width: 758px)": {
              ".logo": {
                "margin-top": "2rem"
              }
            },
            ".mbr-section-subtitle": {
              "color": "#ea1a1a"
            },
            ".cont": {
              "color": "#ffffff"
            }
          },
          "_cid": "v1ZCyiUUAL",
          "_anchor": "footer2-3",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    }
  }
}